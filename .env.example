# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model used for scoring, form answering and the browser agent
JOBBOT_MODEL=claude-opus-5-5

# Where state lives. On Railway, mount a volume at /data.
JOBBOT_DATA_DIR=./data
# Defaults to sqlite in the data dir; set to a Postgres URL in production.
DATABASE_URL=

# Key that encrypts stored site passwords. Generate with: jobbot vault keygen
JOBBOT_VAULT_KEY=

# Personal Gmail OAuth client (Google Cloud console -> Credentials -> Desktop app)
GMAIL_CLIENT_SECRETS=./data/gmail_client_secret.json

# Safety rails
JOBBOT_AUTO_SUBMIT=false        # false = stop at the final submit and queue for approval
JOBBOT_MIN_SCORE=70             # only apply to jobs scoring at least this
JOBBOT_MAX_APPLICATIONS_PER_DAY=10
JOBBOT_HEADLESS=true
